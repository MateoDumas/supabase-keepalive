# OPCIÓN A: Un solo proyecto
SUPABASE_URL=tu-url-de-proyecto.supabase.co
SUPABASE_ANON_KEY=tu-anon-key-de-supabase

# OPCIÓN B: Múltiples proyectos (Formato JSON)
# Nota: Si se usa SUPABASE_PROJECTS, se ignorarán las variables anteriores.
# SUPABASE_PROJECTS='[{"url":"url1","key":"key1","name":"Proyecto1"},{"url":"url2","key":"key2","name":"Proyecto2"}]'
